{
    "name": "km77-game",
    "version": "0.0.0",
    "private": true,
    "description": "Kilómetro 17: El Portón",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "vite preview",
        "test": "npm run test:unit && npm run test:e2e",
        "test:e2e": "playwright test",
        "test:unit": "node --experimental-strip-types --test --experimental-test-isolation=none tests-unit/*.test.ts",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "playcanvas": "^2.24.0"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0",
        "@playwright/test": "^1.59.0",
        "@types/node": "^22.20.5",
        "eslint": "^9.39.5",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "vite": "^8.3.5"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
